{
  "name": "shop",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-29",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shop-db",
